<Window x:Class="FixPrinter.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FixPrinter — печать A3/A4"
        Width="680" Height="640" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Печать документов на принтер" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="Печатает PDF и Word (.doc/.docx) напрямую на принтер, минуя окно настроек драйвера, которое сбоит. Перетащите файлы сюда или нажмите «Добавить файлы»."/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="6">
            <Grid>
                <TextBlock x:Name="EmptyHint" Text="Перетащите сюда PDF или Word файлы"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="12,8" Margin="6,3" Background="#0F172A">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                                        <Button Grid.Column="1" Content="✕" Tag="{Binding Path}" Click="Remove_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{StaticResource MutedBrush}" FontSize="13" Padding="6,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Параметры -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Принтер:" VerticalAlignment="Center" Margin="0,0,12,8"
                       Foreground="{StaticResource TextBrush}" FontSize="13"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PrinterCombo" Margin="0,0,0,8" Height="30" FontSize="13"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Формат:" VerticalAlignment="Center" Margin="0,0,12,8"
                       Foreground="{StaticResource TextBrush}" FontSize="13"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="PaperA4" Content="A4" IsChecked="True" GroupName="paper" Margin="0,0,20,0"
                             Foreground="{StaticResource TextBrush}" FontSize="14" VerticalContentAlignment="Center"/>
                <RadioButton x:Name="PaperA3" Content="A3" GroupName="paper" Margin="0,0,30,0"
                             Foreground="{StaticResource TextBrush}" FontSize="14" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="GrayscaleBox" Content="Чёрно-белая" Foreground="{StaticResource TextBrush}"
                          FontSize="13" VerticalContentAlignment="Center" Margin="0,0,20,0"/>
                <CheckBox x:Name="AutoRotateBox" Content="Поворот под лист" IsChecked="True"
                          Foreground="{StaticResource TextBrush}" FontSize="13" VerticalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Копий:" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{StaticResource TextBrush}" FontSize="13"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CopiesBox" Text="1" Width="60" HorizontalAlignment="Left"
                     Height="28" FontSize="13" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"/>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Content="➕ Добавить файлы"
                    Click="AddFiles_Click"/>
            <Button x:Name="PrintButton" HorizontalAlignment="Right" Style="{StaticResource BigButton}"
                    FontSize="15" Padding="24,11" Content="🖨  Печать" Click="Print_Click"/>
        </Grid>
    </Grid>
</Window>
