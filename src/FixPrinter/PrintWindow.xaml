<Window x:Class="FixPrinter.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FixPrinter — печать A3/A4"
        Width="900" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        x:Name="Root"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Печать документов на принтер" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="PDF и Word печатаются напрямую, в обход сбойного окна драйвера. Добавьте файлы: перетащите их в окно, или скопируйте в проводнике (Ctrl+C) и вставьте сюда (Ctrl+V), или нажмите «Добавить файлы»."/>
        </StackPanel>

        <!-- Основная область: файлы слева, предпросмотр справа -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="6">
                <Grid>
                    <TextBlock x:Name="EmptyHint" Text="Перетащите сюда&#10;PDF или Word" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="FileList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8" Padding="10,7" Background="#0F172A"
                                                    BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter TargetName="bd" Property="Background" Value="#16304A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding Path}" Click="Remove_Click"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="6,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="12" Background="#0B1220"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="6">
                <Grid>
                    <TextBlock x:Name="PreviewHint" Text="Предпросмотр листов появится здесь"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                    <ScrollViewer x:Name="PreviewScroll" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto" Cursor="Hand" Background="Transparent"
                                  PreviewMouseWheel="Preview_MouseWheel"
                                  PreviewMouseLeftButtonDown="Preview_MouseDown"
                                  PreviewMouseMove="Preview_MouseMove"
                                  PreviewMouseLeftButtonUp="Preview_MouseUp">
                        <ItemsControl x:Name="PreviewList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <Border Background="White" CornerRadius="2" Padding="0"
                                                BorderBrush="#334155" BorderThickness="1">
                                            <Image Source="{Binding Image}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Width="{Binding ThumbWidth, ElementName=Root}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Caption}" FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="PreviewBusy" Text="Готовлю предпросмотр…" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" FontSize="13"/>

                    <!-- Панель масштаба предпросмотра -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10"
                            CornerRadius="9" Background="#E61E293B" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="−" Width="30" Style="{StaticResource GhostButton}" Padding="0,3"
                                    FontSize="15" Click="ZoomOut_Click" ToolTip="Уменьшить"/>
                            <TextBlock x:Name="ZoomText" Text="100%" Width="52" TextAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="12.5"/>
                            <Button Content="+" Width="30" Style="{StaticResource GhostButton}" Padding="0,3"
                                    FontSize="15" Click="ZoomIn_Click" ToolTip="Увеличить"/>
                            <Button Content="По ширине" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                    Padding="10,3" FontSize="12" Click="ZoomFit_Click"
                                    ToolTip="Один лист во всю ширину окна предпросмотра"/>
                            <Button Content="Все листы" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                    Padding="10,3" FontSize="12" Click="ZoomReset_Click"
                                    ToolTip="Вернуть мелкие миниатюры"/>
                        </StackPanel>
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Padding="8,3"
                            CornerRadius="7" Background="#CC1E293B" IsHitTestVisible="False">
                        <TextBlock Text="🖱 Колёсико — масштаб · зажмите и тяните — прокрутка" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Параметры -->
        <WrapPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Принтер:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <ComboBox x:Name="PrinterCombo" Width="200" Height="30" FontSize="13"
                          SelectionChanged="Printer_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <RadioButton x:Name="PaperA4" Content="A4" IsChecked="True" GroupName="paper" Margin="0,0,12,0"
                             Foreground="{StaticResource TextBrush}" FontSize="14" VerticalContentAlignment="Center"
                             Checked="Option_Changed"/>
                <RadioButton x:Name="PaperA3" Content="A3" GroupName="paper"
                             Foreground="{StaticResource TextBrush}" FontSize="14" VerticalContentAlignment="Center"
                             Checked="Option_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Масштаб:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <ComboBox x:Name="ScaleCombo" Width="130" Height="30" FontSize="13" SelectionChanged="Option_Changed"/>
                <Button Content="⤢ Вписать в лист" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                        Padding="10,5" FontSize="12.5" Click="FitToSheet_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Ориентация:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <ComboBox x:Name="OrientCombo" Width="120" Height="30" FontSize="13" SelectionChanged="Option_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Страницы:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <TextBox x:Name="PagesBox" Width="100" Height="28" FontSize="13" VerticalContentAlignment="Center"
                         ToolTip="например: 1-3,5 (пусто = все)" LostFocus="Option_Changed" KeyDown="PagesBox_KeyDown"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Лоток:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <ComboBox x:Name="TrayCombo" Width="150" Height="30" FontSize="13"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Двусторонняя:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <ComboBox x:Name="DuplexCombo" Width="150" Height="30" FontSize="13"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock Text="Копий:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextBrush}" FontSize="13"/>
                <TextBox x:Name="CopiesBox" Text="1" Width="46" Height="28" FontSize="13" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="CollateBox" Content="Разобрать" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"
                          Foreground="{StaticResource TextBrush}" FontSize="13"/>
            </StackPanel>
            <CheckBox x:Name="GrayscaleBox" Content="Чёрно-белая" Margin="0,0,16,8" VerticalAlignment="Center"
                      Foreground="{StaticResource TextBrush}" FontSize="13" Click="Option_Changed"/>
        </WrapPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Content="➕ Добавить файлы"
                    Click="AddFiles_Click"/>
            <Button x:Name="PrintButton" HorizontalAlignment="Right" Style="{StaticResource BigButton}"
                    FontSize="15" Padding="24,11" Content="🖨  Печать" Click="Print_Click"/>
        </Grid>
    </Grid>
</Window>
