<Window x:Class="FixPrinter.PrinterManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FixPrinter — управление принтерами"
        Width="680" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Удаление ненужных принтеров" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Отметьте принтеры, которых физически уже нет или которыми не пользуетесь. Удалятся: очередь печати, её драйвер (если больше никем не используется) и TCP/IP-порт. Лишние очереди замедляют диалог печати в Chrome и других программах."/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PrinterList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="12,9" Margin="6,3">
                                <Border.Background>
                                    <SolidColorBrush Color="#0F172A" Opacity="0.55"/>
                                </Border.Background>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="6,-2,0,0">
                                        <TextBlock FontSize="13.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Badge, Mode=OneWay}" Foreground="#38BDF8"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Info, Mode=OneWay}" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="DeleteButton" Style="{StaticResource BigButton}" FontSize="14"
                        Padding="18,10" Content="🗑  Удалить выбранные" Click="Delete_Click"/>
                <Button Style="{StaticResource GhostButton}" Content="Обновить список" Margin="10,0,0,0"
                        Click="Refresh_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
    </Grid>
</Window>
