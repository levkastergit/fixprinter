<Window x:Class="FixPrinter.ModelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FixPrinter — выбор модели принтера"
        Width="560" Height="460" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Какая модель у вас?" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="В этом драйвере несколько моделей. Выберите ту, что написана на самом принтере. Программа уже отметила подходящую."/>
            <TextBlock x:Name="UsbText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="6">
            <ListBox x:Name="ModelList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}" FontSize="14"
                     MouseDoubleClick="ModelList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                            Background="#0F172A" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="bd" Property="Background" Value="#16304A"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1C2B40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="Cancel_Click"/>
            <Button Style="{StaticResource BigButton}" FontSize="14" Padding="18,10" Margin="10,0,0,0"
                    Content="💿  Установить эту модель" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
